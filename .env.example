# Servidor
PORT=3003
LOG_LEVEL=info
NODE_ENV=development

# Servicios internos
API_CENTRAL_URL=http://localhost:3001
INTERNAL_API_TOKEN=cambiar-token-interno
IA_URL=http://localhost:3002
IA_TIMEOUT_MS=20000

# WhatsApp Cloud API (Meta). Si WHATSAPP_TOKEN o WHATSAPP_PHONE_NUMBER_ID
# están vacíos, el bot funciona en modo mock y no envía mensajes reales.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=cambiar-token-de-verificacion
WHATSAPP_API_VERSION=v21.0

# Link al catálogo público
CATALOG_URL=http://localhost:3000
